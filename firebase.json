{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true
    }
  },
  "hosting": {
    "public": "firebase/hosting",
    "ignore": ["**/.*"],
    "cleanUrls": true
  },
  "emulators": {
    "firestore": { "port": 8086 },
    "auth": { "port": 9098 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
